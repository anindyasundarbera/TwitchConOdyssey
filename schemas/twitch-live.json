{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Twitch EventSub channel.chat.message evidence record",
  "description": "Sanitized, bounded receipt evidence. A fixture transport must never set live_verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "origin_label",
    "live_participation",
    "live_verified",
    "fixture",
    "recorded_at",
    "token_validation",
    "subscription",
    "session",
    "receipt_sha256",
    "subject_sha256",
    "command",
    "result",
    "consequence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "origin": {
      "type": "string",
      "enum": ["live", "fixture"]
    },
    "origin_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "live_participation": {
      "type": "boolean"
    },
    "live_verified": {
      "type": "boolean"
    },
    "fixture": {
      "type": "boolean"
    },
    "recorded_at": {
      "type": "integer",
      "minimum": 0
    },
    "token_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated",
        "validated_at",
        "expires_at",
        "client_id_sha256",
        "user_id_sha256",
        "scopes"
      ],
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "validated_at": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0
        },
        "client_id_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "user_id_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id_sha256",
        "type",
        "version",
        "status",
        "subscribed_at"
      ],
      "properties": {
        "subscription_id_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "enum": ["channel.chat.message"]
        },
        "version": {
          "type": "string",
          "enum": ["1"]
        },
        "status": {
          "type": "string",
          "enum": ["enabled"]
        },
        "subscribed_at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id_sha256",
        "connected_at",
        "reconnect_count",
        "keepalive_timeout_seconds"
      ],
      "properties": {
        "session_id_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "connected_at": {
          "type": "integer",
          "minimum": 0
        },
        "reconnect_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "keepalive_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "receipt_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "subject_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "kind",
        "actor_sha256",
        "provenance",
        "logical_tick",
        "sequence",
        "payload"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "enum": ["streamer.steer", "hazard.propose", "viewer.counter"]
        },
        "actor_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "provenance": {
          "type": "string",
          "enum": ["human"]
        },
        "logical_tick": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "type": "string",
              "enum": ["left", "right", "cancel"]
            },
            "hazard_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "kind": {
              "type": "string",
              "enum": ["blocked_demo_lane"]
            },
            "lane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "counter": {
              "type": "string",
              "enum": ["clear_lane"]
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["applied", "expired", "rejected", "duplicate"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "before", "after"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "turn",
            "phase",
            "lane",
            "lateral_pos",
            "transition_remaining_ticks",
            "progress",
            "hazard",
            "warning_active",
            "obstacle_active",
            "hazard_countered",
            "collisions_total",
            "pool",
            "counter_votes_count",
            "eligible_voters_count"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "turn": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "phase": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "lane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "lateral_pos": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "transition_remaining_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "progress": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hazard": {},
            "warning_active": {
              "type": "boolean"
            },
            "obstacle_active": {
              "type": "boolean"
            },
            "hazard_countered": {
              "type": "boolean"
            },
            "collisions_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "pool": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "counter_votes_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "eligible_voters_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "turn",
            "phase",
            "lane",
            "lateral_pos",
            "transition_remaining_ticks",
            "progress",
            "hazard",
            "warning_active",
            "obstacle_active",
            "hazard_countered",
            "collisions_total",
            "pool",
            "counter_votes_count",
            "eligible_voters_count"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "turn": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "phase": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "lane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "lateral_pos": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "transition_remaining_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "progress": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hazard": {},
            "warning_active": {
              "type": "boolean"
            },
            "obstacle_active": {
              "type": "boolean"
            },
            "hazard_countered": {
              "type": "boolean"
            },
            "collisions_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "pool": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "counter_votes_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "eligible_voters_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        }
      }
    }
  }
}
