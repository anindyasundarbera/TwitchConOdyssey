{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "viewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "required": [
    "tick",
    "viewer",
    "text"
  ],
  "additionalProperties": false
}
