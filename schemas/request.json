{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "viewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    }
  },
  "required": [
    "viewer",
    "text",
    "round"
  ],
  "additionalProperties": false
}
