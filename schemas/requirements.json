{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "requirements": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "maxItems": 100
          },
          "threshold": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "description",
          "tests",
          "threshold"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "version",
    "requirements"
  ],
  "additionalProperties": false
}
