{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "passed": {
      "type": "boolean"
    },
    "source_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "evaluation_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "required": [
    "id",
    "passed",
    "source_hash",
    "evaluation_hash",
    "context"
  ],
  "additionalProperties": false
}
