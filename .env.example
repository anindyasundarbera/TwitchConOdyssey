# TwitchCon Odyssey environment template.
#
# Copy to .env for local use. .env is gitignored: never commit real values.
# This project does not auto-load .env. Before starting the runtime, run:
#   set -a; source .env; set +a
#
# Blank or placeholder values do not authorize live calls, capture, repository
# push, YouTube upload or Devpost submission. Keep ALLOW_* at "no" until the
# exact destination and frozen evidence are verified.

# Registered Twitch application name (display only; not a secret).
# Twitch rejected "TwitchCon Odyssey"; the project name is unchanged.
TWITCH_APP_NAME="San Diego Odyssey"

# ── Submission-readiness inputs ────────────────────────────────────────────
# Secure source references, never secret values. Examples:
#   env:TWITCH_CLIENT_ID
#   1password:op://Private/Twitch/client-id
#   aws-secretsmanager:twitchcon-odyssey/client-id
TWITCH_CLIENT_ID_SOURCE=env:TWITCH_CLIENT_ID
TWITCH_USER_OAUTH_TOKEN_SOURCE=env:TWITCH_USER_OAUTH_TOKEN

# Exact authorized Twitch identities. IDs are numeric; login is lowercase.
TWITCH_BROADCASTER_USER_ID=
TWITCH_CHAT_USER_ID=
TWITCH_CHANNEL_LOGIN=

# Consent-safe test account and one bounded command.
# Supported commands: !left, !right, !cancel, !hazard, !counter
TWITCH_TEST_ACCOUNT=twitchsteward
TWITCH_TEST_MESSAGE=!left

# ── Repository, video and Devpost destinations ─────────────────────────────
REPOSITORY_DESTINATION_URL=
YOUTUBE_UPLOAD_TARGET=
# unlisted | public. private is not acceptable for judging.
YOUTUBE_VISIBILITY=
DEVPOST_PROJECT_URL=

# Publication gates. Keep "no" unless the exact target is verified.
ALLOW_REPOSITORY_PUSH=no
ALLOW_YOUTUBE_UPLOAD=no
ALLOW_DEVPOST_FINAL_SUBMIT=no

# ── Live Twitch runtime ────────────────────────────────────────────────────
# Read by: python3 -m server.app --live-twitch
# Minimum scope: user:read:chat. Never print, commit or package these values.
# TWITCH_BROADCASTER_USER_ID and TWITCH_CHAT_USER_ID above are also read here.
TWITCH_CLIENT_ID=
TWITCH_USER_OAUTH_TOKEN=

# ── Optional model configuration ───────────────────────────────────────────
# Mock mode needs no model variables. Export these only for an explicitly
# configured provider; the default runtime uses the deterministic mock.
OPENAI_API_KEY=
OPENAI_MODEL=

# Shared routing path for callers. Pass --policy "$MODEL_POLICY_PATH" explicitly.
# The helper reads neither ambient overrides nor .env automatically.
MODEL_POLICY_PATH=config/model-policy.json

# Optional self-hosted gpt-oss endpoint; disabled until explicitly configured.
OSS_BASE_URL=
